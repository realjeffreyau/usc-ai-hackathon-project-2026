{"id":32414,"name":"3-D Animation in Cinematic Arts Minor","kind":"minor","degree":"Minor","catalog":"2026-2027\nUSC Catalogue","source":"https://catalogue.usc.edu/preview_program.php?catoid=22&poid=32414","intro":"The minor in 3-D Animation in Cinematic Arts offers an introduction to basic animation principles and history, as well as creative and skill-based instruction in 3-D computer animation. Through elective choices, students may focus their studies on their specific area of interest, including visual effects, motion capture, virtual reality, modeling, or character animation. The program requires 16 units.","totalUnits":null,"groups":[{"section":"Core Requirements (4 units)","sub":"","rule":"","courses":[{"code":"CTAN 451","title":"History of Animation","units":"2","or":false},{"code":"CTAN 452","title":"Introduction to 3-D Computer Animation","units":"2","or":false}],"notes":[]},{"section":"Electives (12 Additional Units)","sub":"","rule":"","courses":[{"code":"CTAN 432","title":"The World of Visual Effects","units":"2","or":false},{"code":"CTAN 443L","title":"Character Development for 3-D Animation and Games","units":"2","or":false},{"code":"CTAN 453","title":"3-D Animation for Motion Graphics","units":"2","or":false},{"code":"CTAN 454","title":"Real-Time Animation","units":"2","or":false},{"code":"CTAN 455L","title":"Organic Modeling for Animation","units":"2","or":false},{"code":"CTAN 462","title":"Visual Effects","units":"2","or":false},{"code":"CTAN 464L","title":"Digital Lighting and Rendering","units":"2","or":false},{"code":"CTAN 465L","title":"Digital Effects Animation","units":"2","or":false},{"code":"CTAN 466","title":"Animation for Projection Mapping and Live Performance","units":"2","or":false},{"code":"CTAN 485","title":"Character Modeling","units":"2","or":false},{"code":"CTAN 497L","title":"Procedural Animation","units":"2","or":false},{"code":"CTAN 502L","title":"Experiments in Immersive Design","units":"2","or":false},{"code":"CTAN 504L","title":"Creative Production in Virtual Reality","units":"2","or":false},{"code":"CTAN 508","title":"Compositing and the Art of Creating Visual Styles","units":"2","or":false},{"code":"CTAN 509","title":"Environment Modeling","units":"2","or":false},{"code":"CTAN 511","title":"Demystifying the TV Animation Pipeline","units":"2","or":false},{"code":"CTAN 543","title":"Fictional World Building in Animation","units":"2","or":false},{"code":"CTAN 564L","title":"Motion Capture Fundamentals","units":"2","or":false},{"code":"CTAN 565L","title":"Motion Capture Performance","units":"2","or":false},{"code":"CTAN 572","title":"3-D Motion Graphic Design","units":"2","or":false}],"notes":["Enrollment in 500-level courses requires special permission."]}]}