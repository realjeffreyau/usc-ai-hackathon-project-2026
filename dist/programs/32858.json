{"id":32858,"name":"Creating Dramatic Writing Content Minor","kind":"minor","degree":"Minor","catalog":"2026-2027\nUSC Catalogue","source":"https://catalogue.usc.edu/preview_program.php?catoid=22&poid=32858","intro":"The minor in Creating Dramatic Content presents undergraduate students an opportunity for broadening and deepening expression using the literary and performing arts. This minor offers a foundation for extended expression in dramatic writing and creative writing genres in general; fostering skills in content creation, research, communication and collaboration. The minor is a 16-unit program.","totalUnits":16,"groups":[{"section":"Required Course (4 Units)","sub":"","rule":"","courses":[{"code":"THTR 365","title":"Playwriting I","units":"4","or":false}],"notes":[]},{"section":"Elective Courses (12 units)","sub":"","rule":"","courses":[{"code":"THTR 122","title":"Improvisation and Theatre Games","units":"2","or":false},{"code":"THTR 125","title":"Text Studies for Production","units":"4","or":false},{"code":"THTR 305a","title":"Directing","units":"4","or":false},{"code":"THTR 309","title":"Dramaturgy","units":"4","or":false},{"code":"THTR 312","title":"LGBTQ Theatre","units":"4","or":false},{"code":"THTR 318","title":"Creating the Hit Podcast","units":"2","or":false},{"code":"THTR 365","title":"Playwriting I","units":"4","or":false},{"code":"THTR 366","title":"Playwriting II","units":"4","or":false},{"code":"THTR 395m","title":"Drama as Human Relations","units":"4","or":false},{"code":"THTR 424","title":"Creator as Entrepreneur","units":"2","or":false},{"code":"THTR 465","title":"Playwriting III","units":"4","or":false},{"code":"THTR 467","title":"Going Viral: Performance for New Media","units":"2","or":false},{"code":"THTR 479","title":"Solo Performance","units":"4","or":false}],"notes":[]}]}