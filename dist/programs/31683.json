{"id":31683,"name":"Game Audio Minor","kind":"minor","degree":"Minor","catalog":"2026-2027\nUSC Catalogue","source":"https://catalogue.usc.edu/preview_program.php?catoid=22&poid=31683","intro":"To implement audio into a game requires an understanding that audio forms one part of a game system or algorithm, and even composition must often be thought of in terms of programming-like logic. Game audio professionals must not only be competent in one area (e.g., expressly in music composing, or in audio recording), but in other areas of audio as well. This minor provides a grounding in game design and systems thi","totalUnits":null,"groups":[{"section":"Lower-division Core Units (6 Units)","sub":"","rule":"","courses":[{"code":"CTIN 101","title":"Fundamentals of Procedural Media","units":"2","or":false},{"code":"MTEC 277x","title":"Introduction to Music Technology","units":"4","or":false}],"notes":[]},{"section":"Upper-division Core Units (12 Units)","sub":"","rule":"","courses":[{"code":"CTIN 406L","title":"Sound Design for Games","units":"2","or":false},{"code":"CTIN 444","title":"Audio Expression","units":"2","or":false},{"code":"CTIN 488","title":"Game Design Workshop","units":"4","or":false},{"code":"CTIN 491L","title":"Advanced Game Project I","units":"4","or":false}],"notes":[]},{"section":"Electives (Minimum 6 Additional Units, At Least 4 Upper-division)","sub":"","rule":"","courses":[{"code":"CTIN 289","title":"Game Development Fundamentals","units":"4","or":false},{"code":"CTIN 486","title":"Alternative Control Workshop","units":"2","or":false},{"code":"CTIN 492L","title":"Experimental Game Topics","units":"4","or":false},{"code":"CTIN 493L","title":"Advanced Game Project II","units":"2","or":false},{"code":"CTPR 473","title":"Spotting Music for Cinema","units":"2","or":false},{"code":"MTEC 245","title":"Introduction to MIDI Sequencing","units":"1","or":false},{"code":"MTEC 246","title":"Introduction to Audio Recording and Editing","units":"1","or":false},{"code