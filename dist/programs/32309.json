{"id":32309,"name":"Law and Public Policy Minor","kind":"minor","degree":"Minor","catalog":"2026-2027\nUSC Catalogue","source":"https://catalogue.usc.edu/preview_program.php?catoid=22&poid=32309","intro":"The minor in law and public policy draws upon four fields of study: public policy and management, law, economics and political science. It provides students with an understanding of the political and economic contexts in which laws are made as well as how legal institutions shape policy formulation. Students learn to analyze the consequences of policy and alternatives; the roles played by government, business and non","totalUnits":null,"groups":[{"section":"Required Courses","sub":"","rule":"","courses":[{"code":"PPD 225","title":"Solving Public Problems","units":"4","or":false},{"code":"PPD 314","title":"Public Policy and Law","units":"4","or":false},{"code":"PPD 315","title":"Analytic Foundations for Public Policy","units":"4","or":false},{"code":"POSC 340","title":"Constitutional Law","units":"4","or":true},{"code":"LAW 300","title":"Concepts in American Law","units":"4","or":true},{"code":"PPD 357","title":"Government and Business","units":"4","or":false}],"notes":[]},{"section":"Required Courses","sub":"And one of the following:","rule":"","courses":[{"code":"FBE 403","title":"Introduction to the Legal Environment of Business","units":"4","or":false},{"code":"LAW 200w","title":"Law and Society","units":"4","or":false},{"code":"LAW 403","title":"Mental Health Law","units":"4","or":false},{"code":"POSC 345","title":"International Law","units":"4","or":false},{"code":"POSC 347","title":"Environmental Law","units":"4","or":false},{"code":"POSC 432","title":"Politics of Local Criminal Justice","units":"4","or":false},{"code":"POSC 441m","title":"Cultural Diversity and the Law","units":"4","or":false},{"code":"POSC 444","title":"Civil and Political Rights and Liberties","units":"4","or":false},{"code":"POSC 452","title":"Critical Issues in Law and Public Policy","units":"4","or":false},{"code":"PPD 342","title":"Crime and Public Policy","units":"4","or":false}],"notes":[]}]}